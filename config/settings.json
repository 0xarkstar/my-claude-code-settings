{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "MultiEdit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(ts-node:*)",
      "Bash(pytest:*)",
      "Bash(vitest:*)",
      "Bash(playwright:*)",
      "Bash(turbo:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(echo:*)",
      "Bash(sed:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(make:*)",
      "Bash(cd:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(env:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(curl:*)",
      "Bash(tar:*)",
      "Bash(gh:*)",
      "mcp__pencil",
      "Bash(obsidian:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.testnet)",
      "Read(**/.env.mainnet)",
      "Read(**/secrets/**)",
      "Bash(chmod 777:*)",
      "Read(**/.env.backup)",
      "Read(**/.env.secret)",
      "Read(**/.env.keys)",
      "Read(**/.env.old)",
      "Read(**/.env.bak)",
      "Write(**/.claude/settings*)",
      "Edit(**/.claude/settings*)",
      "Write(**/.claude/hooks/**)",
      "Edit(**/.claude/hooks/**)",
      "Write(**/.claude/scripts/**)",
      "Edit(**/.claude/scripts/**)",
      "Bash(env *OMC_SKIP*:*)",
      "Bash(env *DISABLE_OMC*:*)",
      "Bash(export OMC_SKIP*:*)",
      "Bash(export DISABLE_OMC*:*)",
      "Read(**/Obsidian/Personal/**)",
      "Bash(*Personal*vault*:*)",
      "Bash(*obsidian*Personal*:*)",
      "Bash(ssh localhost:*)",
      "Bash(ssh 127.0.0.1:*)",
      "Bash(ssh *obsidian*Personal*:*)",
      "Bash(*Obsidian/Personal*:*)",
      "Bash(*obsidian*vault=Personal*:*)",
      "Bash(*obsidian*vault=\"Personal\"*:*)",
      "Write(**/Obsidian/Personal/**)",
      "Edit(**/Obsidian/Personal/**)",
      "Bash(*obsidian*eval*:*)",
      "Bash(*obsidian*dev:cdp*:*)",
      "Write(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env.local)",
      "Edit(**/.env.local)",
      "Write(**/.env.development)",
      "Edit(**/.env.development)",
      "Write(**/.env.production)",
      "Edit(**/.env.production)",
      "Write(**/.env.staging)",
      "Edit(**/.env.staging)",
      "Write(**/.env.testnet)",
      "Edit(**/.env.testnet)",
      "Write(**/.env.mainnet)",
      "Edit(**/.env.mainnet)",
      "Write(**/.env.backup)",
      "Edit(**/.env.backup)",
      "Write(**/.env.secret)",
      "Edit(**/.env.secret)",
      "Write(**/.env.keys)",
      "Edit(**/.env.keys)",
      "Write(**/.env.old)",
      "Edit(**/.env.old)",
      "Write(**/.env.bak)",
      "Edit(**/.env.bak)",
      "Bash(* .env*:*)",
      "Bash(*/.env*:*)",
      "Bash(*:.env*:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git push *)",
      "Bash(git force:*)",
      "Bash(docker:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/context-bar.sh"
  },
  "enabledPlugins": {
    "dx@ykdojo": true,
    "clangd-lsp@claude-plugins-official": true,
    "oh-my-claudecode@omc": true
  },
  "extraKnownMarketplaces": {
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      }
    }
  }
}